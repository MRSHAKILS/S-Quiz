# Each port can be switched independently. All "memory"/"none" = zero services needed.
PERSISTENCE=memory          # memory | mongo
LIVE_STORE=memory           # memory | redis
REALTIME=none               # none | ably

MONGODB_URI=mongodb://localhost:27017/squiz   # Atlas M0 SRV string in prod
REDIS_URL=redis://localhost:6379              # Upstash: rediss://default:<pwd>@<host>:6379
ABLY_API_KEY=                                  # server-side only; clients get scoped tokens

# Auth.js (only needed once sign-in is enabled)
AUTH_SECRET=                                   # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Free-tier guard rails
MAX_PLAYERS_PER_SESSION=100
MAX_PLAYERS_GLOBAL=150      # keep below the realtime provider's connection cap
